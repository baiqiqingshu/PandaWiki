# PandaWiki Docker Compose 环境变量
# 复制此文件为 .env 并修改

# Admin 管理后台端口
ADMIN_PORT=8900

# Wiki 前台站点端口 (多站点)
# nginx 会同时监听 WIKI_SITE_PORTS 中的所有端口；
# 每个端口对应一个独立站点（在管理后台创建知识库时指定该端口），
# 新增/删除站点无需重启容器（后端按 host:port 动态解析知识库）。
# 注意：这里列出的每个端口都必须在 docker-compose.yml 的 ports 中映射。
WIKI_SITE_PORTS=8005,8006,8007

# docker-compose 端口映射（与 WIKI_SITE_PORTS 保持一致）
WIKI_PORT_1=8005
WIKI_PORT_2=8006
WIKI_PORT_3=8007

# PostgreSQL 密码
POSTGRES_PASSWORD=panda-wiki-secret

# Redis 密码 (留空则不设密码)
REDIS_PASSWORD=

# NATS 密码
NATS_PASSWORD=

# MinIO 凭证
MINIO_ROOT_USER=s3panda-wiki
MINIO_ROOT_PASSWORD=panda-wiki-secret

# JWT 密钥
JWT_SECRET=panda-wiki-jwt-secret-change-me

# 管理员密码 (留空则使用默认)
ADMIN_PASSWORD=

# RAG Provider (fts=PostgreSQL 全文检索, noop=关闭检索, ct=CT RAG)
RAG_PROVIDER=fts

# Wiki 站点自动初始化（仅首次启动时自动创建示例站点，使用第一个端口）
WIKI_NAME=PandaWiki

# 日志级别 (-4=debug, 0=info, 4=warn, 8=error)
LOG_LEVEL=0
